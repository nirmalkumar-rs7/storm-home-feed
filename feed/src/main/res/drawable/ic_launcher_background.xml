    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="96"
                android:centerY="96"
                android:gradientRadius="130">
                <item android:offset="0.0" android:color="#FFFFF6D8" />
                <item android:offset="0.12" android:color="#FFFFE680" />
                <item android:offset="0.3" android:color="#FFFFD24A" />
                <item android:offset="0.46" android:color="#FFFFB830" />
                <item android:offset="0.6" android:color="#FFFF8A26" />
                <item android:offset="0.76" android:color="#FFF2541E" />
                <item android:offset="0.9" android:color="#FFD22B1E" />
                <item android:offset="1.0" android:color="#FFA81A1E" />
